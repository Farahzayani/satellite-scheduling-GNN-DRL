@inproceedings{stepp_two-stage_2025,
	title = {Two-Stage Optimization Method for Large-Scale Multi-Target Multi-Satellite Tasking},
	issn = {2375-9259},
	url = {https://ieeexplore.ieee.org/document/11415994/},
	doi = {10.1109/ICDMW69685.2025.00123},
	abstract = {This work addresses the problem of large-scale multi-target, multi-satellite tasking, involving hundreds of satellites and thousands of observation targets. The objective is to maximize mission performance metrics, such as target coverage, while satisfying operational constraints, including observation time windows and onboard resource limits. To address this challenge, we propose a two-stage hybrid framework that combines a graph-based pre-solving step with metaheuristic optimization. In the first stage, one or more high-quality initial tasking solutions are generated by the pre-solver that capture structural properties of the tasking problem via a conflict graph. This step produces significantly better starting points compared to naïve or random assignments, while allowing some constraints to remain unmet. In the second stage, a tailored metaheuristic algorithm refines these initial solutions into final tasking schedule that are fully constraint-compliant. Our proposed two-stage approach balances speed, scalability, and constraint complexity, enabling practical and efficient tasking for large satellite constellations in a way not addressed by existing methods.},
	eventtitle = {2025 {IEEE} International Conference on Data Mining Workshops ({ICDMW})},
	pages = {1036--1043},
