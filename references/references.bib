	keywords = {Satellites, Reinforcement learning, Satellite constellations, Time factors, Complexity theory, Graph-based Optimization, Metaheuristic Algorithms, Metaheuristics, Multi-Satellite Tasking, Satellite Constellation, Scalability, Schedules, Surveys, Synthetic data},
	file = {Full Text PDF:C\:\\Users\\ASUS\\Zotero\\storage\\DWFIU54L\\Stepp et al. - 2025 - Two-Stage Optimization Method for Large-Scale Multi-Target Multi-Satellite Tasking.pdf:application/pdf},
